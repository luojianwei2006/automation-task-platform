classDiagram
    class Agreement {
        +Long id
        +String type
        +String title
        +String contentHtml
        +Integer version
        +LocalDateTime updatedAt
        +String updatedBy
    }
    class AgreementMapper {
        +BaseMapper~Agreement~
    }
    class AgreementService_admin {
        +Agreement getByType(String type)
        +Agreement save(AgreementReq req, String operator)
    }
    class AgreementController_admin {
        +ApiResponse~Agreement~ getByType(type)
        +ApiResponse~Agreement~ save(req, operator)
    }
    class AgreementService_user {
        +AgreementVO getByType(String type)
    }
    class AgreementController_user {
        +ApiResponse~AgreementVO~ getByType(type)
    }
    class AgreementVO {
        +String type
        +String title
        +String contentHtml
        +Integer version
        +String updatedAt
    }
    AgreementMapper ..|> Agreement : persists
    AgreementService_admin --> AgreementMapper
    AgreementController_admin --> AgreementService_admin
    AgreementService_user --> AgreementMapper
    AgreementController_user --> AgreementService_user
    AgreementService_user ..> AgreementVO : builds
    Agreement <.. AgreementVO : maps
